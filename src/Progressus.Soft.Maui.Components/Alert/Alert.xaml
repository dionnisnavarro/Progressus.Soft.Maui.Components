<?xml version="1.0" encoding="utf-8" ?>
<components:BorderItem xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fa="clr-namespace:FontAwesome"
             xmlns:components="clr-namespace:Progressus.Soft.Maui.Components"
             x:Class="Progressus.Soft.Maui.Components.Alert"
             ShapeCornerRadius="5" Stroke="Transparent" Padding="0">
    <Grid ColumnDefinitions="5,*,Auto" RowDefinitions="Auto,*">
        <BoxView BackgroundColor="{Binding Source={x:Reference this}, Path=Color}" HorizontalOptions="Fill" Grid.RowSpan="10"/>
        <Grid Grid.ColumnSpan="3" Grid.Column="1" ColumnDefinitions="1,15,*" RowDefinitions="Auto,Auto" ColumnSpacing="5" Padding="0,15,10,15">
            <Image Grid.Column="1" 
                   Source="{Binding Source={x:Reference this}, Path=IconSource}" 
                   VerticalOptions="Center"/>
            <Label Grid.Column="2" Grid.ColumnSpan="10" FontSize="12" FontAttributes="Bold" Text="{Binding Source={x:Reference this}, Path=Title}" 
                   HorizontalOptions="Start" VerticalOptions="Center"/>
            <Label Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="10" Text="{Binding Source={x:Reference this}, Path=Message}" 
                   VerticalOptions="Start"
                   HorizontalTextAlignment="Start"
                   VerticalTextAlignment="Start"/>
        </Grid>

        <Button Grid.Row="1" Grid.Column="1"
                BackgroundColor="Transparent"
                HorizontalOptions="End"
                Text="{Binding Source={x:Reference this}, Path=CancelText}"
                Command="{Binding Source={x:Reference this}, Path=ClosingCommand}" 
                CommandParameter="{Binding Source={x:Reference this}, Path=ClosingCommandParameter}" 
                IsVisible="{Binding Source={x:Reference this}, Path=Dismissible}"
                Clicked="CloseButton_Clicked"/>
        <Button MinimumHeightRequest="10" MinimumWidthRequest="10"
                Text="{Binding Source={x:Reference this}, Path=RefreshText}"
                Grid.Row="1"
                Grid.Column="2"
                Padding="5"
                Margin="5"
                CornerRadius="2"
                HorizontalOptions="End"
                IsVisible="{Binding Source={x:Reference this}, Path=DisplayRefreshButton}" 
                Command="{Binding Source={x:Reference this}, Path=RefreshCommand}"
                CommandParameter="{Binding Source={x:Reference this}, Path=RefreshCommandParameter}" />
    </Grid>
</components:BorderItem>
